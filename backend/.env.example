# Backend local env — copy to `.env.local` and fill in.
# Loaded by cmd/server, cmd/worker, and cmd/mailer (after `.env` if present).

# --- Shared / API server (cmd/server) ----------------------------------------
DB_URL=postgresql://user:pass@localhost:5432/envitoo
CLERK_SECRET_KEY=sk_test_xxx
REDIS_URL=redis://localhost:6379/0
OTP_SECRET=replace-with-long-random-string

# Production DB URL must use TLS:
# DB_URL=postgresql://<user>:<password>@db.example.com:5432/envitoo?sslmode=require
# sslmode=verify-full is better when the CA chain is trusted.
#
# When APP_ENV=production (or DB_REQUIRE_TLS=true), the backend refuses to
# start with sslmode=disable.

# Optional: if set, GET /healthz requires ?pass=<token>
# HEALTHZ_TOKEN=

# Logging (shared by api, worker, mailer)
# LOG_FORMAT=json   # json (default) | text
# LOG_LEVEL=info    # debug | info | warn | error

# Environment: production | development. Forces DB_REQUIRE_TLS when production.
# APP_ENV=production

# DB pool (optional). Defaults: MAX=20, MIN=2, LIFETIME=1h, IDLE=30m.
# MaxConns is per-process (api + worker each open their own pool); keep
# process_count * MaxConns well below Postgres max_connections. A warning is
# logged at startup when MaxConns >= 80% of the DB's max_connections.
# DB_MAX_CONNS=20
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
# DB_HEALTH_CHECK_PERIOD=1m
# DB_DISABLE_PREPARED_STATEMENTS=false   # true when behind PgBouncer (transaction mode)
# DB_REQUIRE_TLS=true                    # reject sslmode=disable (auto in production)

# --- Outbox → NATS worker (cmd/worker) ----------------------------------------
NATS_URL=nats://localhost:4222
# WORKER_BATCH_SIZE=50
# WORKER_POLL_INTERVAL=2s
# WORKER_ACK_WAIT=30s
# WORKER_MAX_RETRIES=5

# --- NATS → Resend mailer (cmd/mailer) ----------------------------------------
RESEND_API_KEY=re_xxx
# Use Resend onboarding sender for local tests, or a verified domain address.
EMAIL_FROM=EnviToo <onboarding@resend.dev>
# SPA origin used in ticket / home links inside emails
APP_PUBLIC_URL=http://localhost:5173

# --- Cloudflare R2 object storage (event cover images) -------------------------
# Required for image uploads; if unset, uploads are disabled (storage nil).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
