# Backend local env — copy to `.env.local` and fill in.
# Loaded by cmd/server, cmd/worker, and cmd/mailer (after `.env` if present).

# --- Shared / API server (cmd/server) ----------------------------------------
DB_URL=postgresql://user:pass@localhost:5432/envitoo
CLERK_SECRET_KEY=sk_test_xxx
REDIS_URL=redis://localhost:6379/0
OTP_SECRET=replace-with-long-random-string

# Optional: if set, GET /healthz requires ?pass=<token>
# HEALTHZ_TOKEN=

# DB pool (optional)
# DB_MAX_CONNS=40
# DB_MIN_CONNS=2

# --- Outbox → NATS worker (cmd/worker) ----------------------------------------
NATS_URL=nats://localhost:4222
# WORKER_BATCH_SIZE=50
# WORKER_POLL_INTERVAL=2s
# WORKER_ACK_WAIT=30s
# WORKER_MAX_RETRIES=5

# --- NATS → Resend mailer (cmd/mailer) ----------------------------------------
RESEND_API_KEY=re_xxx
# Use Resend onboarding sender for local tests, or a verified domain address.
EMAIL_FROM=EnviToo <onboarding@resend.dev>
# SPA origin used in ticket / home links inside emails
APP_PUBLIC_URL=http://localhost:5173
