# Copy to .env and fill in. Clerk publishable key from `clerk apps list`.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Leave empty in dev (uses Vite proxy). Set to backend URL for prod builds.
VITE_API_BASE_URL=

# Optional: Mapbox token for higher-quality address search. Falls back to Photon (free) if unset.
# VITE_MAPBOX_TOKEN=

# Optional: LocationIQ key for address autocomplete + map display (free, 10k req/day).
# Get one at https://locationiq.com → Register. Falls back to Photon (free) if unset.
# VITE_LOCATIONIQ_KEY=
