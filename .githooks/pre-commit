#!/bin/sh
set -euo pipefail

# Ensure Go 1.26+ is on PATH when installed at /usr/local/go
if [ -d /usr/local/go/bin ]; then
    PATH="/usr/local/go/bin:$PATH"
    export PATH
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

PASS=true
REPO_ROOT=$(git rev-parse --show-toplevel)

check() {
    local status=$1; shift
    local label=$1; shift
    if [ "$status" = "0" ]; then
        echo -e "  ${GREEN}✓${NC} $label"
    else
        echo -e "  ${RED}✗${NC} $label"
        PASS=false
    fi
}

# --- 1. Gitleaks: secrets scanning (staged only) ---
echo -e "\n${YELLOW}🔍 Secrets scan (gitleaks)...${NC}"
if command -v gitleaks >/dev/null 2>&1; then
    # Use a temp file instead of a pipe: with `set -o pipefail`, `git diff | gitleaks`
    # can exit 141 (SIGPIPE) after a clean scan and abort before check().
    TMPDIFF=$(mktemp)
    git diff --cached -- . >"$TMPDIFF" || true
    set +e
    if [ -f "$REPO_ROOT/.gitleaks.toml" ]; then
        gitleaks detect --pipe --no-git --config "$REPO_ROOT/.gitleaks.toml" <"$TMPDIFF" >/dev/null 2>&1
    else
        gitleaks detect --pipe --no-git <"$TMPDIFF" >/dev/null 2>&1
    fi
    GL_STATUS=$?
    set -e
    rm -f "$TMPDIFF"
    check "$GL_STATUS" "no secrets detected in staged changes"
else
    echo -e "  ${YELLOW}⚠ gitleaks not installed, skipping${NC}"
fi

# --- 2. Prevent binaries ---
echo -e "\n${YELLOW}📦 Binary check...${NC}"
BINARIES=$(git diff --cached --name-only --diff-filter=A | file -f - 2>/dev/null | grep -i 'Mach-O\|ELF\|PE32' || true)
if [ -n "$BINARIES" ]; then
    echo -e "  ${RED}✗ staged binaries detected:${NC}"
    echo "$BINARIES" | sed 's/^/    /'
    PASS=false
else
    echo -e "  ${GREEN}✓ no binaries staged${NC}"
fi

# --- 3. Prevent .env files ---
echo -e "\n${YELLOW}🔑 Secret file check...${NC}"
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '\.env$|\.env\.local$|\.env\.production$' || true)
if [ -n "$ENV_FILES" ]; then
    echo -e "  ${RED}✗ staged .env files detected:${NC}"
    echo "$ENV_FILES" | sed 's/^/    /'
    PASS=false
else
    echo -e "  ${GREEN}✓ no .env files staged${NC}"
fi

# --- 4. Full quality gate (format, vet, test, lint, typecheck, build) ---
echo -e "\n${YELLOW}🧪 Running make check...${NC}"
set +e
make -C "$REPO_ROOT" check
CHECK_STATUS=$?
set -e
check "$CHECK_STATUS" "make check passed"

# --- Summary ---
echo ""
if [ "$PASS" = true ]; then
    echo -e "${GREEN}✓ All checks passed${NC}"
    exit 0
else
    echo -e "${RED}✗ Some checks failed — commit blocked${NC}"
    echo -e "  To bypass (not recommended): git commit --no-verify"
    exit 1
fi
