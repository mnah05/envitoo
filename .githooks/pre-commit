#!/bin/sh
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

PASS=true
REPO_ROOT=$(git rev-parse --show-toplevel)

check() {
    local status=$1; shift
    local label=$1; shift
    if [ "$status" = "0" ]; then
        echo -e "  ${GREEN}✓${NC} $label"
    else
        echo -e "  ${RED}✗${NC} $label"
        PASS=false
    fi
}

# --- 1. Gitleaks: secrets scanning (staged only) ---
echo -e "\n${YELLOW}🔍 Secrets scan (gitleaks)...${NC}"
if command -v gitleaks &>/dev/null; then
    git diff --cached -- . | gitleaks detect --pipe --no-git -v 2>/dev/null
    check "$?" "no secrets detected in staged changes"
else
    echo -e "  ${YELLOW}⚠ gitleaks not installed, skipping${NC}"
fi

# --- 2. Go formatting ---
echo -e "\n${YELLOW}🎨 Go formatting (gofmt)...${NC}"
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$STAGED_GO" ]; then
    UNFORMATTED=$(echo "$STAGED_GO" | xargs gofmt -l 2>/dev/null || true)
    if [ -n "$UNFORMATTED" ]; then
        echo -e "  ${RED}✗ unformatted files:${NC}"
        echo "$UNFORMATTED" | sed 's/^/    /'
        PASS=false
    else
        echo -e "  ${GREEN}✓ all Go files are formatted${NC}"
    fi
else
    echo -e "  ${GREEN}✓ no staged Go files${NC}"
fi

# --- 3. Go vet on staged packages ---
echo -e "\n${YELLOW}🔬 Go vet...${NC}"
if [ -n "$STAGED_GO" ]; then
    # Determine the Go module root (directory containing go.mod)
    MOD_ROOT=$(git -C "$REPO_ROOT" ls-files --full-name "**/go.mod" | head -1 | xargs -I{} dirname "$REPO_ROOT/{}" 2>/dev/null || echo "$REPO_ROOT")
    if [ -f "$MOD_ROOT/go.mod" ]; then
        # Get unique directories of staged Go files as absolute paths
        STAGED_DIRS=$(echo "$STAGED_GO" | xargs -I{} dirname "$REPO_ROOT/{}" | sort -u)
        VET_FAILED=false
        for dir in $STAGED_DIRS; do
            # Convert to module-relative package path
            PKG="./${dir#$MOD_ROOT/}"
            if ! go vet -C "$MOD_ROOT" "$PKG" 2>/dev/null; then
                VET_FAILED=true
            fi
        done
        if [ "$VET_FAILED" = true ]; then
            echo -e "  ${RED}✗ go vet found issues${NC}"
            PASS=false
        else
            echo -e "  ${GREEN}✓ go vet passed${NC}"
        fi
    else
        echo -e "  ${YELLOW}⚠ go.mod not found, skipping go vet${NC}"
    fi
else
    echo -e "  ${GREEN}✓ no staged Go files to vet${NC}"
fi

# --- 4. Prevent binaries ---
echo -e "\n${YELLOW}📦 Binary check...${NC}"
BINARIES=$(git diff --cached --name-only --diff-filter=A | file -f - 2>/dev/null | grep -i 'Mach-O\|ELF\|PE32' || true)
if [ -n "$BINARIES" ]; then
    echo -e "  ${RED}✗ staged binaries detected:${NC}"
    echo "$BINARIES" | sed 's/^/    /'
    PASS=false
else
    echo -e "  ${GREEN}✓ no binaries staged${NC}"
fi

# --- 5. Prevent .env files ---
echo -e "\n${YELLOW}🔑 Secret file check...${NC}"
ENV_FILES=$(git diff --cached --name-only --diff-filter=A | grep -E '\.env$|\.env\.local$|\.env\.production$' || true)
if [ -n "$ENV_FILES" ]; then
    echo -e "  ${RED}✗ staged .env files detected:${NC}"
    echo "$ENV_FILES" | sed 's/^/    /'
    PASS=false
else
    echo -e "  ${GREEN}✓ no .env files staged${NC}"
fi

# --- Summary ---
echo ""
if [ "$PASS" = true ]; then
    echo -e "${GREEN}✓ All checks passed${NC}"
    exit 0
else
    echo -e "${RED}✗ Some checks failed — commit blocked${NC}"
    echo -e "  To bypass (not recommended): git commit --no-verify"
    exit 1
fi
